"""Explicitly opted-in remote replacement; never run during setup."""
import argparse


def main():
    from pathlib import Path
    from huggingface_hub import HfApi, CommitOperationAdd, CommitOperationDelete

    parser = argparse.ArgumentParser(description="Replace a remote dataset with local Parquet splits, deleting other files.")
    parser.add_argument("repo_id", help="YOUR_USERNAME/dataset-name")
    parser.add_argument("--confirm-replace", action="store_true", help="Explicitly authorize deletion of other remote files")
    args = parser.parse_args()
    if not args.confirm_replace:
        parser.error("Remote replacement requires --confirm-replace; review the destination first")
    repo_id = args.repo_id
    api = HfApi()

    # Check all local files before changing the repository.
    files = {
        f"data/{split}.parquet": Path(__file__).resolve().parent / "parquet" / f"{split}.parquet"
        for split in ("train", "validation", "test")
    }

    for local_path in files.values():
        if not local_path.is_file():
            raise FileNotFoundError(local_path)

    revision = api.repo_info(repo_id, repo_type="dataset").sha
    existing = api.list_repo_files(
        repo_id, repo_type="dataset", revision=revision
    )

    operations = [
        CommitOperationDelete(path_in_repo=path)
        for path in existing
        if path not in files and path != ".gitattributes"
    ]

    operations.extend(
        CommitOperationAdd(
            path_in_repo=remote_path,
            path_or_fileobj=str(local_path),
        )
        for remote_path, local_path in files.items()
    )

    api.create_commit(
        repo_id=repo_id,
        repo_type="dataset",
        parent_commit=revision,
        operations=operations,
        commit_message="Keep only train, validation and test Parquet files",
    )

    print("\n".join(api.list_repo_files(repo_id, repo_type="dataset")))

if __name__ == "__main__":
    main()
